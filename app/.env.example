# CALIBR app secrets — copy this file to ".env" and fill in ONE provider key.
# NEVER commit .env. Keep it private.

# --- Anthropic (Claude) — recommended ---
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-5):
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OR OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Session signing secret (change for production)
SESSION_SECRET=change-me

# Set to "production" behind HTTPS to enable secure cookies + trust proxy
# NODE_ENV=production

# Comma-separated emails that are auto-promoted to admin on signup/login
# ADMIN_EMAILS=kreativethinkinghub@gmail.com

# --- Job-platform OAuth apps (per PLATFORM, set once CALIBR is registered as that platform's developer/partner app) ---
# When both ID and SECRET for a platform are present, the employer's "Connect" button becomes a real
# "Sign in with <platform>" OAuth handshake. Register CALIBR here:
#   LinkedIn: https://www.linkedin.com/developers/apps  (job posting = LinkedIn Talent Solutions partner)
#   Indeed:   https://developer.indeed.com
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# INDEED_CLIENT_ID=
# INDEED_CLIENT_SECRET=

# --- Paystack billing (ZAR) — from your Paystack dashboard (Settings > API Keys) ---
# When the SECRET key is present, seeker subscriptions and the 2% employer success-fee settlement go live.
# Set your webhook URL in Paystack to: https://<your-domain>/paystack/webhook
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
